{
  "name": "sistema-marceneiro-tomada",
  "version": "1.0.0",
  "description": "Sistema de Gerenciamento - Tomada",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "import": "node data/import.js",
    "dev": "node server.js",
    "electron:start": "npx electron electron-main.js",
    "build:installer": "npx electron-builder --win",
    "postinstall": "prisma generate",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@distube/ytdl-core": "^4.16.12",
    "@prisma/client": "^6.19.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@simplewebauthn/server": "^13.3.1",
    "@supabase/supabase-js": "^2.108.1",
    "@turf/turf": "^7.3.5",
    "basic-ftp": "^6.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "ffmpeg-static": "^5.3.0",
    "google-auth-library": "^10.6.2",
    "googleapis": "^172.0.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "multer": "^2.0.0",
    "mysql2": "^3.22.3",
    "nodemailer": "^6.9.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.184.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "yt-dlp-exec": "^1.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.1",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "javascript-obfuscator": "^5.5.0",
    "prisma": "^6.19.3"
  },
  "build": {
    "appId": "com.tomada.planner",
    "productName": "Tomada Planner",
    "files": [
      "electron-main.js",
      "preload.js",
      "public/**/*",
      "server.js",
      "controllers/**/*",
      "routes/**/*",
      "middleware/**/*",
      "data/**/*",
      "prisma/**/*",
      ".env",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.ico",
      "artifactName": "Tomada Planner Setup.exe"
    }
  }
}
