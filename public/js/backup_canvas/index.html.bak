<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="Content-Security-Policy" content="default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; script-src * 'unsafe-inline' 'unsafe-eval' blob:; connect-src * 'unsafe-inline' ws: wss:; img-src * data: blob:; style-src * 'unsafe-inline';">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Sistema de Gerenciamento de Funcionários - Tomada">
  <title>Tomada - Sistema Funcionário</title>
  
  <!-- Inter Font as Fallback for San Francisco -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- Flatpickr for HIG-style Date/Time inputs -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

  <!-- Lucide Icons -->
  <script src="/js/lucide.min.js"></script>
  <script>
    // Initialize Lucide icons after DOM content is loaded
    document.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons({
        attrs: {
          'stroke-width': 1.75
        }
      });
    });
  </script>
  
  <!-- Chart.js for graphs -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <!-- Google Identity Services -->
  <script src="https://accounts.google.com/gsi/client?hl=pt" async defer></script>

  <!-- SimpleWebAuthn Browser SDK for Biometrics -->
  <script src="https://unpkg.com/@simplewebauthn/browser/dist/bundle/index.umd.min.js"></script>

  <!-- Signature Pad for client signatures -->
  <script src="/js/signature_pad.umd.min.js"></script>

  <!-- HTML2PDF -->
  <script src="/js/html2pdf.bundle.min.js"></script>

  <link rel="stylesheet" href="/css/variables.css">
  <link rel="stylesheet" href="/css/reset.css">
  <link rel="stylesheet" href="/css/layout.css?v=2.0">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/animations.css?v=1.2">
  <link rel="stylesheet" href="/css/styles.css?v=4.3">
  <link rel="stylesheet" href="/css/login-desktop.css" media="(min-width: 769px)">
  <link rel="stylesheet" href="/css/cronograma-desktop.css" media="(min-width: 769px)">
  <link rel="stylesheet" href="/css/cronograma-mobile.css" media="(max-width: 768px)">
  <link rel="stylesheet" href="/css/aba-clientes-mobile.css" media="(max-width: 768px)">
  <link rel="stylesheet" href="/css/aba-orcamentos-mobile.css" media="(max-width: 768px)">
  <link rel="stylesheet" href="/css/aba-metas-mobile.css" media="(max-width: 768px)">
  <link rel="stylesheet" href="/css/padeiro-flow.css?v=1.2">
  <link rel="stylesheet" href="/css/tutorial.css?v=1.0">
  <link rel="stylesheet" href="/css/hig-desktop.css">
  <link rel="stylesheet" href="/css/financeiro.css">
  <link rel="stylesheet" href="/css/configuracoes.css">
  <link rel="stylesheet" href="/css/planejamento.css?v=13.0">

  <link rel="icon" type="image/svg+xml" href="/assets/tomada_logo_completa.svg">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#1E4BFF">
  <!-- PWA iOS standalone support -->
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Tomada Funcionário">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
</head>
<body>
  <div id="app"></div>
  <div class="toast-container" id="toast-container"></div>

  <script src="/socket.io/socket.io.js"></script>
  
  <script src="/js/components.js?v=7.0"></script>
  <script src="/js/auth.js?v=7.0"></script>
  <script src="/js/admin-dashboard.js?v=7.0"></script>
  <script src="/js/gestao.js?v=7.0"></script>
  <script src="/js/metas.js?v=7.0"></script>
  <script src="/js/cronograma.js?v=7.0"></script>
  <script src="/js/modules/cronograma/cronograma.styles.js?v=7.0"></script>
  <script src="/js/modules/cronograma/cronograma.render.js?v=7.0"></script>
  <script src="/js/modules/cronograma/cronograma.drag.js?v=7.0"></script>
  <script src="/js/modules/cronograma/cronograma.tasks.js?v=7.0"></script>
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <script src="https://npmcdn.com/flatpickr/dist/l10n/pt.js"></script>
  <script src="/js/modules/cronograma/hig-popovers.js?v=9.0"></script>
  <script src="/js/modules/cronograma/cronograma.mensal.js?v=7.0"></script>
  <script src="/js/modules/cronograma/cronograma.smart.js?v=7.0"></script>
  <script src="/js/modules/cronograma/cronograma.templates.js?v=7.0"></script>
  <script src="/js/padeiro-flow.js?v=7.0"></script>
  <script src="/js/padeiro-agenda.js?v=7.0"></script>
  <script src="/js/padeiro-dashboard.js?v=7.0"></script>
  <script src="/js/dev.js?v=7.0"></script>
  <script src="/js/relatorios.js?v=7.0"></script>
  <script src="/js/orcamentos.js?v=7.0"></script>
  <script src="/js/financeiro.js?v=7.0"></script>
  <script src="/js/tutorial.js?v=7.0"></script>
  <script src="/js/padeiro-tutorial.js?v=7.0"></script>
  <script src="/js/rastreamento.js?v=7.0"></script>
  <script src="/js/configuracoes.js?v=7.0"></script>
  <script src="/js/auditoria.js?v=7.0"></script>
  <script src="/js/descobrir-canais.js?v=7.0"></script>
  <script src="/js/youtube-downloader.js?v=7.0"></script>
  <script src="/js/planejamento.js?v=21.0"></script>
  <script src="/js/app.js?v=8.0"></script>
  <!-- Update Banner (hidden by default) -->
  <div id="pwa-update-banner" style="
    display: none;
    position: fixed;
    bottom: 80px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 99999;
    background: linear-gradient(135deg, #1E4BFF 0%, #1032CC 100%);
    color: #fff;
    padding: 14px 20px;
    border-radius: 16px;
    box-shadow: 0 8px 30px rgba(30,75,255,0.4);
    display: none;
    align-items: center;
    gap: 14px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    min-width: 280px;
    max-width: 90vw;
    animation: slideUpBanner 0.4s cubic-bezier(0.16,1,0.3,1) both;
  ">
    <span style="font-size:20px;">🔄</span>
    <span style="flex:1;">Nova versão disponível!</span>
    <button onclick="window.__applyUpdate()" style="
      background: rgba(255,255,255,0.2);
      border: 1px solid rgba(255,255,255,0.4);
      color: #fff;
      padding: 7px 14px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
    ">Atualizar agora</button>
  </div>
  <style>
    @keyframes slideUpBanner {
      from { opacity: 0; transform: translateX(-50%) translateY(20px); }
      to   { opacity: 1; transform: translateX(-50%) translateY(0); }
    }
  </style>

  <script>
    // ─── Service Worker: Update-First Strategy ───────────────────────────────
    if ('serviceWorker' in navigator) {
      let newWorker = null;

      // Mostra o banner de atualização
      function showUpdateBanner() {
        const banner = document.getElementById('pwa-update-banner');
        if (banner) {
          banner.style.display = 'flex';
          // Auto-aplica após 10 segundos sem interação
          setTimeout(() => { if (newWorker) window.__applyUpdate(); }, 10000);
        }
      }

      // Aplica a atualização imediatamente
      window.__applyUpdate = function() {
        if (newWorker) {
          newWorker.postMessage({ type: 'SKIP_WAITING' });
        } else {
          window.location.reload();
        }
      };

      // Força limpeza total do cache e reload
      window.__forceUpdate = function() {
        if ('serviceWorker' in navigator && navigator.serviceWorker.controller) {
          navigator.serviceWorker.controller.postMessage({ type: 'CLEAR_CACHE' });
        }
        // Limpa todos os caches via CacheStorage API
        if ('caches' in window) {
          caches.keys().then((keys) => Promise.all(keys.map((k) => caches.delete(k))));
        }
        setTimeout(() => window.location.reload(true), 500);
      };

      navigator.serviceWorker.register('/sw.js').then((reg) => {
        console.log('✅ SW registrado. Scope:', reg.scope);

        // Verifica atualização imediatamente
        reg.update();

        // Verifica a cada 5 minutos
        setInterval(() => reg.update(), 5 * 60 * 1000);

        // Verifica atualização imediatamente quando o app volta ao primeiro plano
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible') {
            console.log('👀 App em foco. Checando atualização em background...');
            reg.update();
          }
        });

        // Detecta quando uma nova versão está sendo instalada
        reg.addEventListener('updatefound', () => {
          const installing = reg.installing;
          console.log('📥 Nova versão do SW encontrada — instalando...');

          installing.addEventListener('statechange', () => {
            if (installing.state === 'installed' && navigator.serviceWorker.controller) {
              // Há um SW antigo ativo — novo está pronto
              console.log('✨ Nova versão instalada e pronta!');
              newWorker = installing;
              showUpdateBanner();
            }
            if (installing.state === 'activated' && !navigator.serviceWorker.controller) {
              // Primeira instalação — já está ativo
              console.log('🎉 PWA instalado pela primeira vez!');
            }
          });
        });

        // Se já há um SW esperando (ex: reload com nova versão pendente)
        if (reg.waiting) {
          console.log('⏳ SW atualizado aguardando ativação');
          newWorker = reg.waiting;
          showUpdateBanner();
        }

      }).catch((err) => {
        console.error('❌ Falha ao registrar SW:', err);
      });

      // Quando o SW toma controle: recarrega a página automaticamente
      navigator.serviceWorker.addEventListener('controllerchange', () => {
        console.log('🔄 Novo SW ativo — recarregando...');
        window.location.reload();
      });
    }
  </script>

  <!-- Input estático para recuperação nativa do Chrome em caso de falta de RAM (OOM Crash) -->
  <input type="file" id="camera-input-static" accept="image/*" capture="environment" multiple style="display:none">
</body>
</html>

